{
  "manifest_version": 3,
  "name": "Refboard",
  "version": "0.3.0",
  "description": "Save website screenshots, sections and screen recordings into project folders, then build DESIGN.md and SKILL.md for Claude Code.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Save to Refboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "offscreen",
    "tabCapture"
  ],
  "commands": {
    "quick-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save a screenshot of the visible page to the active project"
    },
    "record-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Record an area of the page (press again to stop)"
    },
    "start-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Pick a section of the page to save"
    }
  }
}
